{
  "name": "proxy-war",
  "version": "2.0.0-alpha.0",
  "description": "PROXY WAR v2 — real-time multiplayer war-economics bluffing game (TypeScript rewrite)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run typecheck:client && npm run build:client",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:client": "tsc -p client/tsconfig.json",
    "smoke:frontend": "node scripts/render-smoke.mjs && node scripts/smoke-frontend.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
